# Groq free API — create one key at https://console.groq.com/keys
# Store only in hosting Preview as a secret. Never use NEXT_PUBLIC_.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Existing GitHub Actions token, server-side Secret only (Actions: write).
GITHUB_ACTIONS_TOKEN=

# Free Agnes AI video API key; store as a GitHub repository Actions secret,
# not in hosting Preview and never commit the real key.
# Get a key at https://platform.agnes-ai.com
# Secret name: AGNES_API_KEY

# Optional Langflow visual workflow editor (not required for core production).
LANGFLOW_BASE_URL=
LANGFLOW_FLOW_ID=
LANGFLOW_API_KEY=

# YouTube Data API v3 OAuth (hosting secrets; never commit real values).
# Register redirect URI: https://YOUR-DOMAIN/api/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
# Generate 32 random bytes and encode as 64 hexadecimal characters.
YOUTUBE_TOKEN_ENCRYPTION_KEY=

# Optional agent observability (Langfuse Cloud free tier or self-hosted).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
