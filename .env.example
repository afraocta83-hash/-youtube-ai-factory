# Groq — primary key and optional backups; server-side secrets only.
GROQ_API_KEY=
GROQ_API_KEY2=
GROQ_API_KEY3=
GROQ_MODEL=openai/gpt-oss-120b

# GitHub Actions — server-side secret with repository Actions read/write permission.
GITHUB_ACTIONS_TOKEN=

# YouTube Data API v3 — public Shorts trend research only (NOT YouTube upload).
# Enable YouTube Data API v3 in Google Cloud, create an API key, restrict it to YouTube Data API v3,
# then add it as a Sensitive/Secret environment variable in Vercel Preview and Production as needed.
YOUTUBE_API_KEY=

# Optional Langflow storyboard provider. Groq remains the fallback.
LANGFLOW_BASE_URL=
LANGFLOW_FLOW_ID=
LANGFLOW_API_KEY=

# Optional Langfuse observability. Not required for production.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# YouTube upload remains manual and owner-approved; no OAuth upload credentials are used.
