# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Existing Gemini key remains configured separately in Vercel.

# FreeLLM OpenAI-compatible gateway (preferred storyboard provider)
# Deploy https://github.com/Devansh-365/freellm separately, then set its reachable URL.
FREELLM_BASE_URL=
FREELLM_API_KEY=
FREELLM_MODEL=free-smart
