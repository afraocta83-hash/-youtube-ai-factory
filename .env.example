# Groq free API — create one key at https://console.groq.com/keys
# Store only in Vercel Preview as Sensitive/Secret. Never use NEXT_PUBLIC_.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Owner-only password. Use a unique random password with at least 24 characters.
# Store as Sensitive/Secret in Vercel Preview; do not commit the real value.
OWNER_PASSWORD=

# Existing GitHub Actions token, server-side Secret only (Actions: write).
GITHUB_ACTIONS_TOKEN=
